[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
ipython = "*"
pillow = "*"
typer = "*"
requests = "*"
pytest = "*"
# 4.10 で Options.headless セッターが削除された。tests/e2e/conftest.py の browser_func が
# それを使っているため、上げるならそちらの書き換えが要る。
selenium = "==4.1.5"
pytest-rerunfailures = "==16.4"

# 本番イメージ(Dockerfile.aws)は requirements.txt を、テストは Pipfile.lock を使う。
# 別々の依存セットなので、ピン留めしないと再lockのたびにテスト環境だけがドリフトして
# 「本番と違うものをテストしている」状態になる。実際 2026-08-10 にそれが起きた
# (flask-socketio だけが 5.6.1 に上がり、ピン留め済みの python-socketio 5.1.0 と
#  非互換になって socketio.Server.reason で全件エラー)。
# 以下は requirements.txt と一致させてある。片方だけ変えないこと。
[packages]
python-socketio = "==5.1.0"
flask = "==2.2.2"
flask-socketio = "==5.3.1"
flask-pymongo = "==2.3.0"
gunicorn = "==20.1.0"
redis = "==4.3.4"
dnspython = "==2.2.1"
eventlet = "==0.33.1"
boto3 = "==1.24.96"
# 推移的依存だが、放っておくと本番とずれて壊れるものを明示的に固定する。
# werkzeug 3.x は flask 2.2.2 と非互換。python-engineio は python-socketio 5.1.0 と対。
python-engineio = "==4.3.4"
werkzeug = "==2.2.2"
pymongo = "==4.3.2"
jinja2 = "==3.1.2"
markupsafe = "==2.1.1"
itsdangerous = "==2.1.2"
